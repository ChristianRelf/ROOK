{
  "name": "@rook/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "migrate": "tsx src/cli/migrate.ts up",
    "migrate:status": "tsx src/cli/migrate.ts status",
    "migrate:down": "tsx src/cli/migrate.ts down",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@rook/auth": "workspace:*",
    "@rook/config": "workspace:*",
    "@rook/contracts": "workspace:*",
    "@rook/observability": "workspace:*",
    "pg": "8.23.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}

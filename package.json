{
  "name": "rook",
  "version": "0.1.0",
  "private": true,
  "description": "Rook \u00e2\u20ac\u201d a modular, Discord-inspired desktop communication platform",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @rook/desktop build",
    "build:packages": "tsc -b packages/config packages/observability packages/contracts packages/database packages/auth packages/messaging packages/queue packages/media",
    "clean": "tsc -b --clean && node scripts/clean.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @rook/database migrate",
    "db:migrate:status": "pnpm --filter @rook/database migrate:status",
    "db:seed": "pnpm --filter @rook/database seed",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @rook/api dev",
    "dev:realtime": "pnpm --filter @rook/realtime dev",
    "dev:worker": "pnpm --filter @rook/media-worker dev",
    "dev:desktop": "pnpm --filter @rook/desktop dev",
    "desktop:tauri": "pnpm --filter @rook/desktop tauri:dev",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "server:init": "node scripts/init-server-env.mjs",
    "server:build": "docker compose -f docker-compose.server.yml --env-file .env.server build",
    "server:up": "docker compose -f docker-compose.server.yml --env-file .env.server up -d --build",
    "server:down": "docker compose -f docker-compose.server.yml --env-file .env.server down",
    "server:logs": "docker compose -f docker-compose.server.yml --env-file .env.server logs -f",
    "server:ps": "docker compose -f docker-compose.server.yml --env-file .env.server ps -a",
    "server:verify": "docker compose -f docker-compose.server.yml -f docker-compose.server.local.yml --env-file .env.server up -d && node tests/stack/verify-server-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rook/auth": "workspace:*",
    "@rook/config": "workspace:*",
    "@rook/contracts": "workspace:*",
    "@rook/database": "workspace:*",
    "@rook/media": "workspace:*",
    "@rook/messaging": "workspace:*",
    "@rook/observability": "workspace:*",
    "@rook/queue": "workspace:*",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}

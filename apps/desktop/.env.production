# Build-time defaults for the packaged desktop client.
#
# These are only DEFAULTS. The sign-in screen exposes a server field, and
# whatever the user sets is persisted and used instead -- so a changed tunnel
# hostname does not require a new binary.
#
# No secrets here, which is why this file is committed: only VITE_-prefixed
# values reach the bundle, and the bundle ships to users.

# The API. The client derives its WebSocket URL as same-origin + /ws, which
# Caddy routes to the realtime gateway.
VITE_API_URL=https://rook.relf.cc

# Kept explicit so local development can run the gateway on a separate port
# without a proxy. In this deployment it is the same origin.
VITE_REALTIME_URL=wss://rook.relf.cc

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rook",
  "version": "0.1.0",
  "identifier": "dev.rook.desktop",

  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Rook",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "http:", "https:"],
        "font-src": "'self'",
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http:", "https:", "ws:", "wss:"],
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },

      "capabilities": ["default"],

      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Rook desktop client",
    "longDescription": "A modular, self-hostable communication client."
  }
}

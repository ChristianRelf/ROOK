# ---------------------------------------------------------------------------
# Rook server configuration (home server, behind a Cloudflare tunnel)
#
#   pnpm server:init --token=<cloudflare tunnel token>
#
# generates `.env.server` from this file with every secret filled in, which
# also keeps DATABASE_URL and REDIS_URL in step with their passwords. To do it
# by hand instead:
#
#   cp .env.server.example .env.server
#   # then fill in every value marked CHANGE ME
#
# Used only by docker-compose.server.yml. `.env` is the development file and
# is not read here.
#
# This file holds real credentials. It is git-ignored; keep it that way.
# ---------------------------------------------------------------------------

# --- Public addresses ------------------------------------------------------
#
# Two hostnames, both routed by the Cloudflare tunnel. They must be separate:
# presigned storage URLs are signed over the exact host and path the client
# requests, so putting storage behind a path prefix on the main hostname
# invalidates every signature.

# The API and the realtime gateway. The client derives its WebSocket URL as
# same-origin + /ws, and Caddy routes that to the gateway.
PUBLIC_HOSTNAME=rook.relf.cc

# Object storage. Clients PUT and GET presigned URLs here directly.
#
# Note this is a SIBLING of PUBLIC_HOSTNAME, not a child of it. Cloudflare's
# free Universal SSL covers the apex and one wildcard level, so
# `files.rook.relf.cc` would have no certificate at the edge and every upload
# would fail TLS. `rook-files.relf.cc` is covered by `*.relf.cc`.
PUBLIC_FILES_HOSTNAME=rook-files.relf.cc


# --- Cloudflare tunnel -----------------------------------------------------
#
# CHANGE ME. From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels
# -> your tunnel -> Install and run a connector. Copy the token from the
# command it shows (the long string after `--token`).
#
# The token grants access to route traffic into this network. Treat it as a
# credential.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME


# --- Runtime ---------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
# Keep false: JSON logs are what `docker compose logs` and any aggregator want.
LOG_PRETTY=false
SHUTDOWN_GRACE_SECONDS=20


# --- HTTP API --------------------------------------------------------------

# 0.0.0.0 inside the container so Caddy can reach it over the Docker network.
# Nothing is published to the host, so this is not internet-exposed.
API_HOST=0.0.0.0
API_PORT=4000

# How clients reach the API. Must match PUBLIC_HOSTNAME.
API_PUBLIC_URL=https://rook.relf.cc

# Origins allowed to call the API. The Tauri webview reports one of the
# tauri:// origins; localhost:1420 is the dev server, and can be removed once
# you are only using built binaries. Never "*".
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420


# --- Realtime gateway ------------------------------------------------------

REALTIME_HOST=0.0.0.0
REALTIME_PORT=4001
REALTIME_PUBLIC_URL=wss://rook.relf.cc

REALTIME_HEARTBEAT_INTERVAL_MS=25000
REALTIME_HEARTBEAT_TIMEOUT_MS=60000
REALTIME_MAX_FRAMES_PER_WINDOW=120
REALTIME_RATE_WINDOW_MS=10000
REALTIME_MAX_BUFFERED_BYTES=1048576


# --- PostgreSQL ------------------------------------------------------------

POSTGRES_USER=rook
# CHANGE ME: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rook

# Host is the compose service name, not localhost: these are separate
# containers on one network.
DATABASE_URL=postgres://rook:CHANGE_ME@postgres:5432/rook

# Per process, and three services share one PostgreSQL. 10 x 3 = 30, well
# inside the container's max_connections=100.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# False: traffic between containers never leaves the host.
DATABASE_SSL=false


# --- Redis -----------------------------------------------------------------

# CHANGE ME: openssl rand -base64 32
# Must not contain : / @ or ? -- it goes in a URL below.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_KEY_PREFIX=rook:
REDIS_MAXMEMORY=512mb


# --- Sessions and password hashing ----------------------------------------

# 30 days. Sessions are revocable server-side regardless.
SESSION_TTL_SECONDS=2592000

# CHANGE ME: openssl rand -base64 48
# Mixed into the session-token hash, so a stolen database dump alone yields no
# usable tokens. Changing it signs everyone out.
SESSION_TOKEN_PEPPER=CHANGE_ME

# ~19 MiB, 2 passes. Raise memory first if you want it slower; existing hashes
# keep working and are upgraded as people sign in.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1


# --- Object storage --------------------------------------------------------

# Internal: how the services reach storage.
S3_ENDPOINT=http://storage:8333

# Public: baked into presigned URLs, so it must be what the *client* can
# reach. This is why the separate hostname exists.
S3_PUBLIC_ENDPOINT=https://rook-files.relf.cc

S3_REGION=us-east-1
S3_BUCKET_MEDIA=rook-media

# CHANGE ME (both): openssl rand -hex 16
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Required for SeaweedFS and MinIO; false only for real AWS S3.
S3_FORCE_PATH_STYLE=true

# Origins storage accepts a direct browser PUT from. Same list as CORS above.
S3_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420


# --- Media pipeline --------------------------------------------------------

# 10 MiB.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_MAX_IMAGE_DIMENSION=10000
MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_DOWNLOAD_URL_TTL_SECONDS=900
MEDIA_ORPHAN_CLEANUP_AFTER_SECONDS=3600


# --- Queue -----------------------------------------------------------------

QUEUE_PREFIX=rook-jobs
# Roughly the server's core count. Image work is CPU-bound, so higher just
# means more jobs contending for the same CPU.
QUEUE_MEDIA_CONCURRENCY=2
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=2000


# --- Transactional outbox --------------------------------------------------

OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=200
OUTBOX_RETENTION_SECONDS=86400


# --- Rate limits -----------------------------------------------------------
#
# Tuned for a handful of users. Raise if you add more.
#
# Note: every request arrives from the tunnel, so per-IP limits see
# Cloudflare's address rather than the real client. Message and upload limits
# are per authenticated user and are unaffected; the auth limits are therefore
# effectively shared across everyone signing in.

RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_MESSAGE_WINDOW_MS=10000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

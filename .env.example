# ---------------------------------------------------------------------------
# Rook environment reference
#
# Copy to `.env` and adjust. Every variable the services read is listed here.
# Config is validated at startup (packages/config); a missing or malformed
# required value aborts the process rather than defaulting silently.
#
#   cp .env.example .env
#
# Public addresses are set for rook.relf.cc. Ports, bind addresses and the
# PostgreSQL / Redis / storage connection strings stay on loopback, because
# those are the local docker-compose stack (`pnpm infra:up`) and are reached
# from this machine. Each public value has its local-only alternative
# commented directly beneath it.
#
# This file is for running the services directly with `pnpm dev`. The
# containerised deployment reads `.env.server` instead -- a separate file
# with its own template (`.env.server.example`) and real secrets.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# development | test | production. Controls log formatting and error detail.
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Pretty-prints logs. Leave false in production so logs stay machine-readable.
LOG_PRETTY=true


# --- HTTP API (apps/api) ---------------------------------------------------

API_HOST=127.0.0.1
API_PORT=4000

# How the desktop client reaches the API. Used for links the API generates.
# This is the public address, not the bind address: API_HOST above stays on
# loopback and the Cloudflare tunnel reaches it from the inside.
API_PUBLIC_URL=https://rook.relf.cc
# Fully local instead, with nothing reaching this machine from outside:
# API_PUBLIC_URL=http://127.0.0.1:4000

# Comma-separated exact origins allowed to call the API with credentials.
# The Tauri webview reports one of the tauri:// origins; the Vite dev server
# reports http://localhost:1420. Never use "*" here.
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Seconds to let in-flight requests finish during graceful shutdown.
SHUTDOWN_GRACE_SECONDS=15


# --- Realtime gateway (apps/realtime) --------------------------------------

REALTIME_HOST=127.0.0.1
REALTIME_PORT=4001

# WebSocket URL the desktop client connects to. Same hostname as the API:
# Caddy routes /ws to the gateway without rewriting the path.
REALTIME_PUBLIC_URL=wss://rook.relf.cc
# Fully local instead:
# REALTIME_PUBLIC_URL=ws://127.0.0.1:4001

# Client must answer a heartbeat within this window or the socket is closed.
REALTIME_HEARTBEAT_INTERVAL_MS=25000
REALTIME_HEARTBEAT_TIMEOUT_MS=60000

# Inbound frames per connection per window before the client is throttled.
REALTIME_MAX_FRAMES_PER_WINDOW=120
REALTIME_RATE_WINDOW_MS=10000

# Drop a connection whose outbound buffer exceeds this (slow-consumer
# backpressure). The client reconnects and resyncs from its last event id.
REALTIME_MAX_BUFFERED_BYTES=1048576


# --- PostgreSQL ------------------------------------------------------------

# Primary source of truth. Must match the docker-compose credentials below.
#
# If port 5432 is already taken on your machine (another project's Postgres,
# or a system install), change POSTGRES_PORT at the bottom of this file and
# update the port here to match -- docker-compose reads POSTGRES_PORT and
# the application reads DATABASE_URL, so both have to agree.
DATABASE_URL=postgres://rook:rook_dev_password@127.0.0.1:5432/rook

# Per-process pool ceiling. Multiply by instance count and keep the total
# below the server's max_connections (200 in docker-compose.yml).
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Server-side guard against runaway queries. Keeps transactions short.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Set true when connecting to a managed Postgres that requires TLS.
DATABASE_SSL=false


# --- Redis -----------------------------------------------------------------

# Cache, presence, rate limiting, the queue and cross-instance event fan-out.
# Redis holds no durable application state: anything here can be rebuilt
# from PostgreSQL.
REDIS_URL=redis://127.0.0.1:6379

# Namespace prefix so several environments can share one Redis instance.
REDIS_KEY_PREFIX=rook:


# --- Sessions & password hashing ------------------------------------------

# Session lifetime. Tokens are revocable server-side regardless of this.
SESSION_TTL_SECONDS=2592000

# Server-side secret mixed into the session-token hash, so a leaked database
# dump alone does not yield usable tokens. MUST be changed per environment:
# generate with `openssl rand -base64 48`. Minimum 32 characters.
SESSION_TOKEN_PEPPER=dev-only-pepper-change-me-0123456789abcdefghij

# Argon2id parameters. The defaults target roughly 50-100ms per hash on a
# development machine. Raise memory first when hardening.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1


# --- Object storage (S3-compatible) ---------------------------------------

# SeaweedFS locally (docker-compose); a real S3/R2/B2 endpoint in production.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET_MEDIA=rook-media
S3_ACCESS_KEY_ID=rook-local-access-key
S3_SECRET_ACCESS_KEY=rook-local-secret-key

# Required for SeaweedFS and MinIO; set false for real AWS S3.
S3_FORCE_PATH_STYLE=true

# Endpoint baked into presigned URLs handed to clients. Differs from
# S3_ENDPOINT when the services talk to storage over a private network --
# which is the case here: the services use the loopback endpoint above,
# clients use the hostname below.
#
# Storage needs its own hostname rather than a path on the main one.
# Presigned URLs are signed over the exact host AND path requested, so a
# proxy rewriting /files/... would invalidate every signature.
#
# It is a sibling of the API hostname rather than a child of it: Cloudflare's
# free Universal SSL covers one wildcard level, so `files.rook.relf.cc` would
# have no certificate at the edge. See docs/self-hosting.md.
S3_PUBLIC_ENDPOINT=https://rook-files.relf.cc
# Fully local instead:
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333


# --- Media pipeline --------------------------------------------------------

# Hard ceiling enforced both when issuing the upload URL and when verifying
# the stored object. 10 MiB.
MEDIA_MAX_UPLOAD_BYTES=10485760

# Decompression-bomb guards, checked from the image header before full decode.
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_MAX_IMAGE_DIMENSION=10000

# Content types accepted for upload. Enforced against the file's actual magic
# bytes after upload, never against the client-supplied type.
MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif

# Presigned URL lifetimes. Keep uploads short.
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_DOWNLOAD_URL_TTL_SECONDS=900

# Reserved uploads never confirmed by the client are swept after this long.
MEDIA_ORPHAN_CLEANUP_AFTER_SECONDS=3600


# --- Queue (services/media-worker) ----------------------------------------

QUEUE_PREFIX=rook-jobs
QUEUE_MEDIA_CONCURRENCY=4

# Retries are idempotent, so a failed job can safely be attempted again.
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=2000


# --- Transactional outbox --------------------------------------------------

# The relay polls committed outbox rows and publishes them to Redis. Lower
# interval means lower delivery latency and more database round trips.
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=200

# Published rows are kept this long for debugging, then pruned.
OUTBOX_RETENTION_SECONDS=86400


# --- Rate limits -----------------------------------------------------------

# Login and registration, per IP.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Message sends, per user.
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_MESSAGE_WINDOW_MS=10000

# Upload authorisations, per user.
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=60000

# Everything else, per IP.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000


# --- Desktop client (apps/desktop, Vite build-time) -----------------------
#
# Only VITE_-prefixed variables reach the frontend bundle. Never put a secret
# behind this prefix: the bundle ships to users.

# These are only the baked-in defaults. The sign-in screen has a "Change
# server" field, and whatever is set there wins, so a changed hostname
# never requires a new binary.
VITE_API_URL=https://rook.relf.cc
VITE_REALTIME_URL=wss://rook.relf.cc

# Point the dev client at a backend running on this machine instead:
# VITE_API_URL=http://127.0.0.1:4000
# VITE_REALTIME_URL=ws://127.0.0.1:4001


# --- docker-compose overrides ---------------------------------------------
#
# Read by docker-compose.yml itself, not by the application.

POSTGRES_USER=rook
POSTGRES_PASSWORD=rook_dev_password
POSTGRES_DB=rook
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
